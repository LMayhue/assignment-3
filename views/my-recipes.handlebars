{{!-- Current user's own recipes. Controller passes: title, recipes --}}
<div class="page-header">
  <h1>My Recipes</h1>
  <a href="/recipes/new" class="btn">+ New Recipe</a>
</div>

{{#if recipes}}
  <div class="card-grid">
    {{#each recipes}}
      {{> recipe-card}}
    {{/each}}
  </div>
{{else}}
  <p class="empty-state">You haven't created any recipes yet. <a href="/recipes/new">Create your first one.</a></p>
{{/if}}
