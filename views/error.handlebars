{{!-- Error page (403, 404, 500). errorHandler passes: title, message --}}
<section class="error-page card">
  <h1>{{title}}</h1>
  <p>{{message}}</p>

  <div class="form-actions">
    <a href="/" class="btn">Go Home</a>
    <a href="/recipes" class="btn btn-secondary">Browse Recipes</a>
  </div>
</section>
