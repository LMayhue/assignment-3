{{!-- Browse all recipes. Controller passes: title, recipes, recipeCount, search --}}
<div class="page-header">
  <h1>Browse Recipes</h1>

  {{#if user}}
    <a href="/recipes/new" class="btn">+ New Recipe</a>
  {{/if}}
</div>

{{!-- Search form keeps the current search term in the box --}}
<form class="search-form" method="GET" action="/recipes">
  <input type="search" name="q" value="{{search}}" placeholder="Search by title or ingredient" aria-label="Search recipes">
  <button type="submit" class="btn">Search</button>

  {{#if search}}
    <a href="/recipes" class="btn btn-secondary">Clear</a>
  {{/if}}
</form>

{{!-- Result summary line --}}
<p class="result-count">
  {{recipeCount}} recipe(s){{#if search}} matching "<strong>{{search}}</strong>"{{/if}}
</p>

{{#if recipes}}
  <div class="card-grid">
    {{#each recipes}}
      {{> recipe-card}}
    {{/each}}
  </div>
{{else}}
  <p class="empty-state">No recipes found.</p>
{{/if}}
