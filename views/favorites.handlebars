{{!-- Current user's favorites. Controller passes: title, user, recipes --}}
<div class="page-header">
  <h1>My Favorites</h1>
</div>

{{#if recipes}}
  <div class="card-grid">
    {{#each recipes}}
      {{!-- Everything on this page is favorited, so fill the heart --}}
      {{> recipe-card favorited=true}}
    {{/each}}
  </div>
{{else}}
  <p class="empty-state">You haven't favorited anything yet. <a href="/recipes">Browse recipes</a></p>
{{/if}}
