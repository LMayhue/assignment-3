{{!--
  Reusable recipe card.
  Use inside an {{#each recipes}} loop:   {{> recipe-card}}
  The current context is one recipe row from BASIC_QUERY
  (id, title, description, prep_time, cook_time, servings, user_id, author, favorite_count).

  Optional: pass is_favorited=true to show a filled heart:   {{> recipe-card is_favorited=true}}

  Clicking anywhere on the card opens the recipe:
    .card-link stretches an invisible layer over the whole card (see style.css).
    .card-author-link sits above that layer, so the author name still opens their profile.
--}}
<article class="card recipe-card">
  <h3 class="card-title">
    <a class="card-link" href="/recipes/{{id}}">{{title}}</a>
  </h3>

  <p class="card-meta">
    by <a class="card-author-link" href="/users/{{user_id}}">{{author}}</a>
  </p>

  {{!-- Description is optional in the database --}}
  {{#if description}}
    <p class="card-text">{{description}}</p>
  {{/if}}

  <ul class="card-stats">
    {{#if prep_time}}
      <li>Prep: {{prep_time}} min</li>
    {{/if}}
    {{#if cook_time}}
      <li>Cook: {{cook_time}} min</li>
    {{/if}}
    {{#if servings}}
      <li>Serves {{servings}}</li>
    {{/if}}

    {{!-- Heart + favorite count --}}
    <li class="fav-count {{#if is_favorited}}is-favorited{{/if}}">
      {{#if is_favorited}}&#9829;{{else}}&#9825;{{/if}} {{favorite_count}}
    </li>
  </ul>
</article>
